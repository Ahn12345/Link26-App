# Link26-App — 예시 환경 변수 목록
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. `.env` 는 Git에 올리지 마세요.
#
# 앱 빌드 시 Gradle은 `assets/env/dotenv` 를 번들합니다. OneDrive·한글 경로 이슈를 피하려고
# 루트 `.env` 를 직접 asset 하지 않습니다. `.\tool\run_bff_and_flutter.ps1` / `run_with_ascii_path.ps1` 가
# 빌드 직전 `sync_dotenv_asset.ps1` 로 복사합니다. 수동만 할 때:  .\tool\sync_dotenv_asset.ps1
#
# Flutter는 기본적으로 .env를 자동으로 읽지 않습니다. `lib/core/constants/api_keys.dart`의
# String.fromEnvironment(...) 와 맞추려면 빌드 시 --dart-define 또는
# --dart-define-from-file 로 같은 이름을 주입하거나, 사용 중인 dotenv 로더 규칙에 맞추세요.
#
# --- Gemini (AI 채팅·처방 OCR 2패스) — AI 채팅은 이 키가 있어야 Gemini로 응답합니다 ---
# Google AI Studio: https://aistudio.google.com/apikey  → 프로젝트 루트 .env 에 붙여넣기 → flutter 재빌드
# 따옴표 없이: GEMINI_API_KEY=AIza...   (pubspec.yaml assets 에 .env 포함 필수)
GEMINI_API_KEY=
# 선택. 기본 gemini-2.5-flash (지원 목록은 AI Studio 문서 참고)
GEMINI_MODEL_ID=gemini-2.5-flash

# --- 백엔드 REST (Dio `ApiClient.dio`, `.env` 로드 시) ---
# Android 에뮬레이터에서 PC 로컬 서버: http://10.0.2.2:8080
API_BASE_URL=
# 처방/OCR 분석 전용 전체 URL(선택). 비우면 `API_BASE_URL` + `/ai/prescription`
AI_API_URL=

# --- 국민건강보험·BFF (반드시 이 레포의 Dart BFF: `dart run tool/link26_bff.dart`) ---
# NHIS_BASE_URL 은 위 Dart BFF 주소만 사용하세요. 다른 종류의 API 서버 URL을 넣으면
# 틸코·심평원 복약 플로우(`/v1/flow/tilko-hira-medications` 등)가 맞지 않습니다.
# 에뮬레이터 → PC: http://10.0.2.2:8787 (실제 포트는 BFF 기동 시 콘솔에 표시)
# 로컬 https 권장. http 는 Android 디버그 빌드에서만(usesCleartextTraffic) 테스트 가능.
# 폰만 쓰고 PC BFF를 안 띄울 때: NHIS_BASE_URL 을 비우거나 NHIS_USE_MOCK=true 로 두세요.
# (주소만 남기면 끊긴 PC로 붙다 타임아웃·알림이 반복될 수 있습니다.)
#
# 개발용 목(mock): true 이면 가입/로그인·복약 동기화만 로컬 목 데이터로 "성공"처럼 동작합니다.
# (공공데이터 e약은요·틸코 등 BFF 프록시는 NHIS_BASE_URL 만 있으면 mock 과 무관하게 호출됩니다.)
# 로컬에서 BFF 없이 로그인/가입 흐름만 보려면 true 로 두세요.
# 복약을 BFF 실데이터로 받으려면 false + 틸코(TILKO_*)·NHIS_BASE_URL 설정이 필요합니다.
NHIS_USE_MOCK=true
# 심사·실연동: Dart BFF 베이스 URL — 실행·포트는 `bff/README.md` 또는 `dart run tool/link26_bff.dart` 콘솔
NHIS_BASE_URL=
#
# 스토어 릴리스(APK/AAB): PC 없이 운영 서버만 쓰려면 dotenv 가 아니라 빌드 시 define 사용
# (릴리스에서는 아래 NHIS_BASE_URL 은 무시되고 NHIS_PRODUCTION_BASE_URL 만 적용됨)
#   flutter build apk --release --dart-define=NHIS_PRODUCTION_BASE_URL=https://api.yourdomain.com
# 가입 연동 API 경로 (기본 /v1/signup). BFF 라우트에 맞게 바꿉니다.
NHIS_SIGNUP_PATH=/v1/signup
# (선택) 실제 게이트웨이가 있으면 전체 URL — Dart BFF가 POST 본문을 그대로 전달합니다.
# 비우면 BFF가 스텁 응답(ok·received)만 반환합니다.
# NHIS_PROXY_SIGNUP_URL=https://your-api.example.com/v1/nhis/signup
# 공공데이터포털 serviceKey(앱 일부 API·BFF e약은요 폴백). e약은요 전용 키가 없으면 BFF가 여기 값을 씁니다.
NHIS_SERVICE_KEY=
# true 이면 NHIS 전송 실패 시 로컬 가입도 취소됩니다.
NHIS_SIGNUP_REQUIRED=false
# 로그인 연동 POST 경로 (기본 /v1/login)
NHIS_LOGIN_PATH=/v1/login
# NHIS_PROXY_LOGIN_URL=https://your-api.example.com/v1/nhis/login
# true 이면 NHIS 로그인 연동 실패 시 앱 로그인(홈 진입)도 하지 않습니다.
NHIS_LOGIN_REQUIRED=false
# 복약·약 목록 GET (쿼리 phone=, 선택 serviceKey=). 기본 /v1/medications
NHIS_MEDICINES_PATH=/v1/medications
# 앱이 BFF에 넘길 connectedId (선택). 설정 화면에 저장한 값이 우선합니다.
# NHIS_CODEF_CONNECTED_ID=

# 기본 끔. 복약 동기화 결과(CODEF 안내 등)를 홈에서 스낵바로 보려면 true 로 두세요.
NHIS_SHOW_SYNC_SNACKBARS=false

# --- Dart BFF (`dart run tool/link26_bff.dart`) CODEF 실연동 — **비활성(주석). 복약은 틸코 HIRA `hiraa050300000100`** ---
# # true 이면 /v1/medications 가 CODEF 상품을 호출합니다. 상품 URL·파라미터는
# # https://developer.codef.io 에서 건강/복약 해당 API 문서와 동일하게 맞추세요.
# # 계정 등록 후 발급된 connectedId 가 많은 상품에 필요합니다.
# # CODEF_MEDICATION_PATH 를 비우면 아래 CODEF_NHIS_TREATMENT_PATH(틸코·건보 플로우와 동일 URL)를 복약 GET에도 씁니다.
# BFF_USE_CODEF_FOR_MEDICATIONS=false
# # 예: 개발 서버 https://development.codef.io (운영: https://api.codef.io)
# CODEF_BASE_URL=https://development.codef.io
# # 문서의 상품 요청 URL 경로 (반드시 / 로 시작). 예시는 문서 확인 후 기입.
# # CODEF_MEDICATION_PATH=/v1/kr/public/hw/p/...
# CODEF_MEDICATION_PATH=
# # 앱·BFF: 복약 GET `?connectedId=`. 비우면 로컬 DB·설정 화면 저장값 사용.
# # 홈 스낵바는 기본 꺼짐(`NHIS_SHOW_SYNC_SNACKBARS` 미설정 또는 false). 안내를 보려면 true.
# CODEF_CONNECTED_ID=
# # true 이면 connectedId 없이도 CODEF 호출 시도(상품이 필수가 아닐 때만)
# # BFF_ALLOW_CODEF_WITHOUT_CONNECTED_ID=false
# # 상품별 기관코드(organization) — 문서 필수 항목이면 기입.
# # Tilko→CODEF 플로우에서는 codef_payload에 없을 때 본문에 자동으로 넣습니다.
# CODEF_HW_ORGANIZATION=

# --- 앱 코드와 직접 대응하는 base URL (api_keys.dart, dart-define) ---
# NHIS_BASE_URL=
DUR_BASE_URL=
MEDICINE_OVERVIEW_BASE_URL=
SIMPLE_AUTH_BASE_URL=

# --- 공공데이터포털 · 식약처 의약품개요정보(e약은요) 등 ---
# 발급받은 일반 인증키(Encoding/Decoding)를 서버 또는 게이트웨이에서 사용하는 경우
DATA_GO_KR_SERVICE_KEY=

# --- 건강보험 건강iN 진료·투약 정보 (CODEF API 가이드 기준) — **비활성(주석)** ---
# # 앱에서는 [CodefRuntimeConfig] 로 읽습니다. 실연동·토큰 발급은 보통 BFF 권장.
# CODEF_CLIENT_ID=
# CODEF_CLIENT_SECRET=
# CODEF_PUBLIC_KEY=
# # 콘솔에 표기된 API Host — CODEF_BASE_URL 이 비어 있으면 상품 호스트 후보의 첫 값으로 사용됩니다.
# # BASE 와 다르면(예: 샌드박스 URL만 복사한 경우) 둘 다 순서대로 시도해 CF-00003/00017 완화에 도움이 됩니다.
# CODEF_API_HOST=

# --- 틸코블렛 API (간편인증) — BFF .env 또는 앱 직접 호출(개발용) ---
# 데모: https://dev.tilko.net  운영: https://api.tilko.net
TILKO_API_KEY=
TILKO_API_HOST=https://dev.tilko.net
# 가입/로그인 후 자동 플로우(틸코 간편인증 → 심평원 **내가 먹는 약** `hiraa050300000100`)에 쓰는 채널. 앱이 dotenv에서 읽음(BFF는 API_KEY·HOST만 사용).
# 예: KAKAO, NAVER, PASS, TOSS … (틸코 문서 PrivateAuthType)
TILKO_PRIVATE_AUTH_TYPE=KAKAO

# --- Dart BFF: 식약처 e약은요 (DrbEasyDrugInfo) — `GET /v1/public/easy-drug` ---
# 우선순위: PUBLIC_DATA_SERVICE_KEY → DATA_GO_KR_SERVICE_KEY → NHIS_SERVICE_KEY
PUBLIC_DATA_SERVICE_KEY=

# --- Dart BFF: 틸코 간편인증 후 심평원 복약 (`POST /v1/flow/tilko-hira-medications`, 구 `tilko-codef-treatment`) — CODEF 블록은 비활성 ---
# 가입 완료 시(주민번호 입력 직후)·로그인 시(다이얼로그로 주민번호 한 번 입력) 앱이 이 API를 호출해
# 심평원 투약 이력을 받고 내 약 목록에 반영합니다. NHIS_BASE_URL·TILKO_API_KEY 필요.
# # CODEF_CLIENT_ID / SECRET / CODEF_BASE_URL 은 위 CODEF 블록과 동일 (현재 주석 처리됨)
# # CODEF_NHIS_TREATMENT_PATH=/v1/kr/public/each/pp/nhis-insurance-treatment-information
# # 오타 /public/cach/pp/ 는 302·502로 이어질 수 있음 — BFF가 each 로 보정하지만 .env는 each 로 맞추는 것을 권장.
# # 틸코 응답이 있을 때 루트 loginType 을 같이 넣어야 하면 true (기본 false — 이중 지정 시 CF-00003 가능)
# CODEF_NHIS_INCLUDE_LOGINTYPE_WITH_TILKO=false
# # CODEF 건보 진료·투약 본문: 샘플과 동일하게 간편인증 시 loginType=5, loginTypeLevel 은 채널별(카카오=1 등)
# CODEF_NHIS_LOGINTYPE=5
# # 비우면 앱 틸코 요청의 PrivateAuthType(KAKAO 등)에서 추론
# CODEF_NHIS_LOGINTYPE_LEVEL=
# # 내부 검증 스크립트(verify_codef_nhis)용 더미값 — verify 스크립트는 CODEF 비활성
# CODEF_VERIFY_PLACEHOLDER_NAME=
# CODEF_VERIFY_PLACEHOLDER_PHONE=
# CODEF_VERIFY_PLACEHOLDER_IDENTITY=
# # CF-00404/404 시: CODEF_BASE_URL을 키 환경(개발·운영·샌드박스)과 맞추고, 경로는 developer.codef.io 해당 상품 «요청 URL»과 동일하게.

# (구명) 틸코 예시 키 이름 — 사용 시 TILKO_* 로 통일 권장
TILCOBLET_CLIENT_ID=
TILCOBLET_CLIENT_SECRET=

# --- lib/data/DUR1(병용금기)·DUR2(노인주의) ---
# 현재 저장소에는 해당 경로에 CSV 누적 데이터가 포함되어 로컬로 사용할 수 있습니다.
# 공공데이터 등 외부 API로 DUR1/DUR2 데이터를 받아오는 경우에만 아래를 채우면 됩니다.
DUR1_API_KEY=
DUR2_API_KEY=
