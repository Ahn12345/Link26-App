{
  "$comment": "link26-frontend 루트 vercel.json 과 병합. 기존 SPA rewrite 가 있으면 아래 rewrites 블록을 합치세요.",
  "headers": [
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Link26-1.0.0.apk\""
        }
      ]
    },
    {
      "source": "/link26-bff.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.(apk|json|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|css|js|map|txt|xml)$).*)",
      "destination": "/index.html"
    }
  ]
}
