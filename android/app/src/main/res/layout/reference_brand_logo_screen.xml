<?xml version="1.0" encoding="utf-8"?>
<!--
  참조용 레이아웃 — 브랜드 로고·환영 (logo.png).
  실제 앱 UI는 Flutter. 기획/검수용. 에셋 경로: @string/flutter_image_logo
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/link26_scaffold_tint"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/link26_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/link26_space_md"
            android:background="@color/link26_surface"
            android:elevation="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="144dp"
                android:background="@color/link26_chip_tint"
                android:contentDescription="@string/flutter_image_logo"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/link26_space_sm"
                android:gravity="center"
                android:text="@string/flutter_image_logo"
                android:textColor="@color/link26_on_surface_muted"
                android:textSize="@dimen/link26_caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/link26_space_md"
                android:gravity="center"
                android:text="@string/reference_brand_welcome_title"
                android:textColor="@color/link26_on_surface"
                android:textSize="@dimen/link26_header_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/link26_space_xs"
                android:gravity="center"
                android:text="@string/reference_brand_welcome_subtitle"
                android:textColor="@color/link26_text_secondary"
                android:textSize="@dimen/link26_body" />
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/link26_space_lg"
            android:backgroundTint="@color/link26_send_button"
            android:minHeight="52dp"
            android:text="@string/reference_brand_cta_login"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/link26_space_sm"
            android:backgroundTint="@color/link26_surface"
            android:minHeight="52dp"
            android:text="@string/reference_brand_cta_signup"
            android:textAllCaps="false"
            android:textColor="@color/link26_primary" />
    </LinearLayout>
</ScrollView>
