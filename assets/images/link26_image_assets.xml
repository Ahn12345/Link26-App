<?xml version="1.0" encoding="UTF-8"?>
<!--
  원본: 이 폴더의 PNG + 본 카탈로그(1:1). 제작 산출(XML)은 동기화 도구가 갱신합니다.
  워크플로: PNG 교체/추가 → link26_image_assets.xml 에 <image> 등록 →
  dart run tool/sync_image_specs_from_assets.dart
  → link26_image_production.xml(실측 스냅샷) + ../design/png/link26_png_<id>.xml 내 <measured/>
  플레이스홀더만 필요할 때: dart run tool/gen_image_assets.dart 후 위 sync 재실행.
  색·간격·라운드: ../design/link26_design_tokens.xml
  반응형 상한: ../design/link26_responsive_images.xml
  Dart 경로: lib/core/constants/image_assets.dart (ImageAssets)
  PNG 인덱스: ../design/png/link26_png_index.xml
-->
<link26-images version="1">
  <image id="applogo" file="applogo.png" dart-const="ImageAssets.applogo"
         usage="런처·스플래시·브랜드 소형 아이콘" />
  <image id="logo" file="logo.png" dart-const="ImageAssets.logo"
         usage="환영·더보기 등 브랜드 로고" />
  <image id="login" file="login.png" dart-const="ImageAssets.login"
         usage="로그인 화면 일러스트" />
  <image id="signup" file="signup.png" dart-const="ImageAssets.signup"
         usage="회원가입 화면 일러스트" />
  <image id="home" file="home.png" dart-const="ImageAssets.home"
         usage="전체 목업 참고용(필요 시 화면에서만 사용 — 홈 탭 배경 중복 주의)" />
  <image id="aichat" file="aichat.png" dart-const="ImageAssets.aichat"
         usage="AI 채팅 탭·관련 화면 에셋" />
  <image id="setting" file="setting.png" dart-const="ImageAssets.setting"
         usage="더보기 탭 전체 배경(탭 최초 진입 시에만 로드)" />
  <image id="pillsearch" file="pillsearch.png" dart-const="ImageAssets.pillsearch"
         usage="약 검색 화면 히어로" />
  <image id="emergencycall" file="emergencycall.png" dart-const="ImageAssets.emergencycall"
         usage="비상 연락·설정 일러스트" />
  <image id="familyadd" file="familyadd.png" dart-const="ImageAssets.familyadd"
         usage="가족 추가 안내 일러스트" />
  <image id="simplelogin1" file="simplelogin1.png" dart-const="ImageAssets.simplelogin1"
         usage="월간 HIRA 간편인증 안내 1단계" />
  <image id="simplelogin2" file="simplelogin2.png" dart-const="ImageAssets.simplelogin2"
         usage="월간 HIRA 간편인증 안내 2단계" />
</link26-images>
