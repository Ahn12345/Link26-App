<?xml version="1.0" encoding="utf-8"?>
<!--
  Link26 — assets/images 단일 목록 (기능 ↔ PNG 파일명).
  • file: 이 폴더(assets/images) 안의 실제 파일명과 반드시 일치.
  • flutter: Flutter Image.asset / pubspec 번들 경로.
  • android_drawable: 네이티브 미리보기용 res/drawable-nodpi/link26_*.png 복사본(빌드 스크립트·동기화용 이름).

  PNG 내용을 바꿀 때는 file 이름은 유지하고 파일만 교체하거나,
  이름을 바꾸면 이 XML·design_assets.dart·link26_flutter_image_paths.xml·nodpi 복사를 함께 맞출 것.
-->
<link26_image_registry version="1">
