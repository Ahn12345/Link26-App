<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그인 화면 스펙.
  히어로 반응형: link26_responsive_images.xml → screen id="login"
  PNG: link26_image_assets.xml → id="login" (login.png)
-->
<link26-screen-spec version="1" id="login" kind="auth" title="로그인">
  <hero
      catalogId="login"
      file="login.png"
      responsiveScreenId="login"
      flutterConst="ImageAssets.login" />
  <!--
    연동: BFF 없이 로그인/가입이 멈추면 .env 에 NHIS_USE_MOCK=true 또는 NHIS_BASE_URL 비움.
    NHIS_LOGIN_REQUIRED=true 인데 서버가 없으면 로그인 후 홈으로 가지 않습니다.
  -->
  <integration nhisMockWhenNoBff="true" />
  <flutter path="lib/features/auth/login/login_page.dart" />
  <android-reference layout="reference_login_screen.xml" />
</link26-screen-spec>
